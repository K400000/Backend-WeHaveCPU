# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment Variables (ความลับของระบบ ห้าม push ขึ้น Git)
.env
.env.local
.env.*.local

# API Documentation Directory & Spec (บล็อกไฟล์ docs และ swagger.yaml)
/docs/
swagger.yaml
*.yaml

# Uploaded Files (บล็อกรูปภาพที่อัปโหลดเข้ามา แต่เว้นไฟล์ .gitkeep ไว้เพื่อรักษาโครงสร้างโฟลเดอร์)
public/uploads/*
!public/uploads/.gitkeep
public/uploads/products/*
!public/uploads/products/.gitkeep
public/uploads/profiles/*
!public/uploads/profiles/.gitkeep

# Logs & Runtime Data
logs/
*.log
pids/
*.pid
*.seed

# OS & Editor Files
.DS_Store
Thumbs.db
.vscode/
.idea/